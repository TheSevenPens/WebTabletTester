{
    "name": "web-tablet-tester",
    "private": true,
    "version": "2.1.0-beta.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:browser": "playwright test",
        "verify": "npm run lint && npm run check && npm run format:check && npm test && npm run test:browser && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^24.19.0",
        "eslint": "^10.0.2",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^15.12.0",
        "prettier": "^3.4.2",
        "prettier-plugin-svelte": "^3.2.6",
        "svelte": "^5.45.2",
        "svelte-check": "^4.7.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^7.3.1",
        "vitest": "^5.0.2"
    },
    "engines": {
        "node": "24.x"
    }
}
